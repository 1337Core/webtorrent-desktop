{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "lib": ["ES2024"],
    "tsBuildInfoFile": ".cache/tsbuildinfo/node.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/engine/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
