{
  "name": "webtorrent-updated",
  "productName": "WebTorrent Updated",
  "version": "1.0.0-dev",
  "description": "A maintained personal WebTorrent desktop client for Apple Silicon Macs.",
  "author": {
    "name": "WebTorrent contributors",
    "url": "https://github.com/webtorrent/webtorrent-desktop"
  },
  "license": "MIT",
  "private": true,
  "main": "build/main/index.mjs",
  "homepage": "https://github.com/1337Core/webtorrent-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/1337Core/webtorrent-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/1337Core/webtorrent-desktop/issues"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "devEngines": {
    "cpu": {
      "name": "arm64",
      "onFail": "error"
    },
    "os": {
      "name": "darwin",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/assert-toolchain.mjs && node scripts/build.mjs",
    "check:deps": "node scripts/assert-toolchain.mjs && knip",
    "clean": "node scripts/assert-toolchain.mjs && node scripts/clean.mjs",
    "dev": "node scripts/assert-toolchain.mjs && electron-forge start",
    "format": "node scripts/assert-toolchain.mjs && prettier --check .",
    "format:write": "node scripts/assert-toolchain.mjs && prettier --write .",
    "lint": "node scripts/assert-toolchain.mjs && eslint .",
    "package": "node scripts/assert-toolchain.mjs && electron-forge package --platform=darwin --arch=arm64",
    "package:check": "node scripts/assert-toolchain.mjs && npm run package && npm run verify:package && npm run smoke:package",
    "smoke:dev": "node scripts/assert-toolchain.mjs && npm run build && electron . --m2-smoke",
    "smoke:supervision:dev": "node scripts/assert-toolchain.mjs && npm run build && electron . --m2-smoke-restart && electron . --m2-smoke-crash-loop",
    "smoke:package": "node scripts/assert-toolchain.mjs && node scripts/smoke-package.mjs",
    "start": "npm run dev",
    "test": "node scripts/assert-toolchain.mjs && npm run format && npm run lint && npm run typecheck && npm run check:deps && npm run test:unit",
    "test:unit": "node scripts/assert-toolchain.mjs && vitest run",
    "typecheck": "node scripts/assert-toolchain.mjs && tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.renderer.json",
    "verify:package": "node scripts/assert-toolchain.mjs && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@thaunknown/simple-peer": "10.1.1",
    "bencode": "4.0.1",
    "electron-store": "11.0.2",
    "parse-torrent": "11.0.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.29.0",
    "webtorrent": "3.0.16",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "bittorrent-tracker": "11.2.3",
    "electron": "43.2.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@thaunknown/simple-peer": "10.1.1",
    "webrtc-polyfill": "1.2.2",
    "node-datachannel": "0.32.3"
  },
  "allowScripts": {
    "bufferutil": false,
    "fsevents": false,
    "ip-set": false,
    "node@24.18.0": true,
    "node-datachannel@0.32.3": true,
    "utf-8-validate": false,
    "utp-native": false
  }
}
