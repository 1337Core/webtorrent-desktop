{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "forge.config.cjs",
    "scripts/*.mjs",
    "src/engine/index.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/index.tsx",
    "src/shared/**/*.test.ts",
    "e2e/**/*.e2e.ts"
  ],
  "ignoreDependencies": [
    "@thaunknown/simple-peer",
    "@wdio/local-runner",
    "bittorrent-tracker"
  ],
  "project": ["scripts/**/*.mjs", "src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts"]
}
