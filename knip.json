{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "forge.config.cjs",
    "scripts/*.mjs",
    "src/engine/index.ts",
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/index.tsx",
    "src/engine/soak/**/*.soak.ts",
    "e2e/**/*.e2e.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "ignoreBinaries": ["openssl"],
  "ignoreDependencies": ["@wdio/local-runner", "bittorrent-tracker"],
  "project": ["scripts/**/*.mjs", "src/**/*.ts", "src/**/*.tsx", "e2e/**/*.ts"]
}
